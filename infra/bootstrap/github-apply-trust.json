{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubProductionEnvironmentOnly",
      "Effect": "Allow",
      "Principal": { "Federated": "arn:aws:iam::832866945974:oidc-provider/token.actions.githubusercontent.com" },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:ahsan-niloy/Cloud-Computing-University-Project:environment:production"
        }
      }
    }
  ]
}
