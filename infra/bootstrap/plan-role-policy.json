{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListStateBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::aura-tfstate-ak-seng4620-x7k2"
    },
    {
      "Sid": "ReadState",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::aura-tfstate-ak-seng4620-x7k2/*"
    },
    {
      "Sid": "WriteLockFileOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::aura-tfstate-ak-seng4620-x7k2/*.tflock"
    },
    {
      "Sid": "NeverReadComplianceRecords",
      "Effect": "Deny",
      "Action": "s3:GetObject*",
      "Resource": "arn:aws:s3:::aura-compliance-*/*"
    }
  ]
}
