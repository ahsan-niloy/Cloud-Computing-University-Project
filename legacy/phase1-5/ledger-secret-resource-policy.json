{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyReadExceptLedgerRoleAndAdmins",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::832866945974:role/aura-ledger-ec2-role",
            "arn:aws:iam::832866945974:user/Ahsan-Admin",
            "arn:aws:iam::832866945974:user/Kareena-Admin"
          ]
        }
      }
    }
  ]
}
